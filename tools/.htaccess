# =============================================================================
# KantEase - tools/: never reachable over HTTP.
# =============================================================================
#
# Development-only Node scripts that validate the schema, check static
# references and split SQL files. They are not part of the shipped application
# and there is no reason for a browser to reach them.
#
# They are run from the command line:
#
#   node tools\run-all-checks.js "C:\xampp\php\php.exe"

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes